{
  "config": {
    "default": true,
    // Prose is wrapped by hand and tables can be wide.
    "MD013": false,
  },
  "globs": ["**/*.md"],
  "ignores": [
    ".git/**",
    "node_modules/**",
    ".private/**",
    ".claude/**",
    "_output/**",
    "dist/**",
    "dist-app/**",
    "coverage/**",
    "reports/**",
    "playwright-report/**",
    "test-results/**",
    ".lighthouseci/**",
    ".stryker-tmp/**",
    "CHANGELOG.md",
  ],
}
