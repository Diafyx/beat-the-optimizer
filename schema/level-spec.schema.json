{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Diafyx/beat-the-optimizer/blob/main/schema/level-spec.schema.json",
  "title": "Beat the Optimizer level spec",
  "description": "The dataset of one level, generated from a seed, and the puzzle around it. The format is in docs/level-spec.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["seed", "tables", "afterAnalyze", "level"],
  "properties": {
    "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "tables": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/table" }
    },
    "afterAnalyze": {
      "description": "SQL statements run after ANALYZE, so the statistics no longer match the data.",
      "type": "array",
      "items": { "$ref": "#/$defs/text" }
    },
    "level": { "$ref": "#/$defs/level" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*$" },
    "value": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "map": {
      "description": "What each value of the source column becomes; every value needs a mapping.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "$ref": "#/$defs/value" },
          "to": { "$ref": "#/$defs/value" }
        }
      }
    },
    "level": {
      "description": "The puzzle: the text the player reads, and the query PostgreSQL plans, built from its parts.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "story",
        "select",
        "filters",
        "joins",
        "orderBy",
        "locks",
        "stats",
        "explanation"
      ],
      "properties": {
        "id": { "$ref": "level.schema.json#/properties/id" },
        "title": { "$ref": "#/$defs/text" },
        "story": { "$ref": "level.schema.json#/$defs/paragraphs" },
        "select": {
          "description": "The columns the query returns.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "level.schema.json#/$defs/columnRef" }
        },
        "filters": { "type": "array", "items": { "$ref": "#/$defs/filter" } },
        "joins": { "type": "array", "items": { "$ref": "level.schema.json#/$defs/join" } },
        "orderBy": { "$ref": "level.schema.json#/properties/orderBy" },
        "locks": { "$ref": "level.schema.json#/properties/locks" },
        "stats": {
          "description": "The columns whose statistics the player is shown.",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "level.schema.json#/$defs/columnRef" }
        },
        "explanation": { "$ref": "level.schema.json#/$defs/paragraphs" }
      }
    },
    "filter": {
      "description": "A predicate on one column; a row must pass every filter.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["table", "column", "op", "value"],
          "properties": {
            "table": { "$ref": "#/$defs/name" },
            "column": { "$ref": "#/$defs/name" },
            "op": { "enum": ["=", "<", "<=", ">", ">="] },
            "value": { "$ref": "#/$defs/value" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["table", "column", "op", "values"],
          "properties": {
            "table": { "$ref": "#/$defs/name" },
            "column": { "$ref": "#/$defs/name" },
            "op": { "const": "in" },
            "values": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/value" } }
          }
        }
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rows", "order", "columns", "indexes"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "rows": { "type": "integer", "minimum": 1, "maximum": 3000000 },
        "order": {
          "description": "The insert order: \"shuffled\", or the name of a column to insert in ascending order of.",
          "$ref": "#/$defs/name"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/column" }
        },
        "indexes": { "type": "array", "items": { "$ref": "#/$defs/index" } }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "values"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "enum": ["integer", "bigint", "text", "date"] },
        "values": { "$ref": "#/$defs/values" }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "column"],
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "column": { "$ref": "#/$defs/name" },
        "unique": { "type": "boolean" }
      }
    },
    "values": {
      "oneOf": [
        {
          "description": "start, start + 1, ... in generation order.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "sequence" },
            "start": { "type": "integer" }
          }
        },
        {
          "description": "A uniformly random integer from min to max.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "min", "max"],
          "properties": {
            "kind": { "const": "uniform" },
            "min": { "type": "integer" },
            "max": { "type": "integer" }
          }
        },
        {
          "description": "Each value on exactly its share of the rows, rounded by largest remainder, in random order.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "weights"],
          "properties": {
            "kind": { "const": "weighted" },
            "weights": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "weight"],
                "properties": {
                  "value": { "$ref": "#/$defs/value" },
                  "weight": { "type": "number", "exclusiveMinimum": 0 }
                }
              }
            }
          }
        },
        {
          "description": "A uniformly random date from from to to, both included.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "from", "to"],
          "properties": {
            "kind": { "const": "dateRange" },
            "from": { "$ref": "#/$defs/date" },
            "to": { "$ref": "#/$defs/date" }
          }
        },
        {
          "description": "A uniformly random value of a column of an earlier table.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "table", "column"],
          "properties": {
            "kind": { "const": "reference" },
            "table": { "$ref": "#/$defs/name" },
            "column": { "$ref": "#/$defs/name" }
          }
        },
        {
          "description": "The value an earlier column of the same row maps to, so the two are fully correlated.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "column", "map"],
          "properties": {
            "kind": { "const": "derived" },
            "column": { "$ref": "#/$defs/name" },
            "map": { "$ref": "#/$defs/map" }
          }
        },
        {
          "description": "The value that a column of the referenced row maps to, so this column follows the row that an earlier reference column of the same table points to.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "through", "column", "map"],
          "properties": {
            "kind": { "const": "follows" },
            "through": {
              "description": "An earlier reference column of the same table.",
              "$ref": "#/$defs/name"
            },
            "column": {
              "description": "A column of the table that through references.",
              "$ref": "#/$defs/name"
            },
            "map": { "$ref": "#/$defs/map" }
          }
        },
        {
          "description": "prefix followed by the row's number in generation order, such as \"author 7\".",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "prefix"],
          "properties": {
            "kind": { "const": "label" },
            "prefix": { "type": "string" }
          }
        }
      ]
    }
  }
}
