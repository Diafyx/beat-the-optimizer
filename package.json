{
  "name": "beat-the-optimizer",
  "version": "0.0.0",
  "private": true,
  "description": "A daily puzzle: pick a join plan and try to beat the PostgreSQL query optimizer.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.engine.json",
    "unit": "vitest run --coverage",
    "coverage": "node scripts/not-configured.mjs coverage 4",
    "levels": "node scripts/not-configured.mjs levels 15",
    "e2e": "node scripts/not-configured.mjs e2e 9",
    "a11y": "node scripts/not-configured.mjs a11y 9",
    "lighthouse": "node scripts/not-configured.mjs lighthouse 9",
    "bundle-size": "node scripts/not-configured.mjs bundle-size 9",
    "docs": "markdownlint-cli2",
    "check-filters": "node scripts/not-configured.mjs check-filters 4",
    "check": "npm run lint && npm run typecheck && npm run unit && npm run levels && npm run docs && npm run check-filters && npm run build",
    "check-all": "npm run check && npm run coverage && npm run e2e && npm run a11y && npm run lighthouse && npm run bundle-size"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
